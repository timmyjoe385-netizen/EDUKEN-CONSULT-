{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eduken-consult",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/ai-assistant",
      "/api/analytics/events",
      "/api/analytics/summary"
    ]
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "eduken-analytics-production",
      "database_id": "fb684d86-f289-4cee-aa34-5767f8c08094"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "ANALYTICS_DB",
        "database_name": "eduken-analytics-preview",
        "database_id": "ec1f170c-c00d-4975-a6ca-bb35958772f6"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "env": {
    "preview": {
      "name": "eduken-consult-preview",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/ai-assistant",
          "/api/analytics/events",
          "/api/analytics/summary"
        ]
      },
      "d1_databases": [
        {
          "binding": "ANALYTICS_DB",
          "database_name": "eduken-analytics-preview",
          "database_id": "ec1f170c-c00d-4975-a6ca-bb35958772f6"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
