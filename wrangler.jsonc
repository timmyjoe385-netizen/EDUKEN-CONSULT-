{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eduken-consult",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/ai-assistant"]
  },
  "ai": {
    "binding": "AI"
  }
}
